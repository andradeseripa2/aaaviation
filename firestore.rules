rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'andradeseripa2@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Posts Collection
    match /posts/{postId} {
      allow read, write: if true;
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read, write: if true;
    }

    // Ratings Collection
    match /ratings/{ratingId} {
      allow read, write: if true;
    }

    // Newsletter Subscribers
    match /newsletter/{subId} {
      allow read, write: if true;
    }

    // Contact Messages
    match /contacts/{msgId} {
      allow read, write: if true;
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Settings (Ads, Categories, etc)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Briefings & Newsletter Campaigns
    match /briefings/{briefingId} {
      allow read, write: if true;
    }

    // Media & Article Images Collection
    match /media/{mediaId} {
      allow read, write: if true;
    }
  }
}

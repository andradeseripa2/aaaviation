rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FUNÇÕES AUXILIARES
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin mestre: reconhecido direto pelo e-mail do token de autenticação.
    // Não depende de nenhum documento no banco, então não pode ser forjado.
    function isMasterAdmin() {
      return isSignedIn() &&
             request.auth.token.email == 'andradeseripa2@gmail.com';
    }

    // Admin: o mestre, ou quem tiver role 'admin' no próprio documento de usuário.
    // Seguro porque a regra de /users abaixo impede que alguém altere o próprio role.
    function isAdmin() {
      return isMasterAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Conjunto de campos que esta escrita está alterando.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ============================================================
    // CONTEÚDO PÚBLICO — leitura livre, escrita só do admin
    // A leitura pública de /posts é obrigatória: o build do SSG
    // (scripts/generate-ssg.js) lê essa coleção sem autenticação.
    // ============================================================

    match /posts/{postId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      // O admin edita tudo. O visitante anônimo só pode mexer nos dois
      // contadores — qualquer outro campo na mesma escrita derruba a regra.
      allow update: if isAdmin()
                    || changedKeys().hasOnly(['viewsCount', 'likesCount']);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // INTERAÇÃO DO LEITOR — qualquer um participa, só o admin modera
    // ============================================================

    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;

      // As respostas ficam DENTRO do documento do comentário (campo `replies`),
      // então responder, curtir resposta e apagar a própria resposta são todas
      // alterações no comentário de outra pessoa. A primeira versão desta regra
      // só liberava `likes` e bloqueava tudo isso para leitores comuns — o admin
      // não percebia, porque para ele tudo é permitido.
      allow update: if isAdmin()
                    // curtir um comentário
                    || changedKeys().hasOnly(['likes'])
                    // responder, curtir resposta, apagar a própria resposta e
                    // atualizar nome/foto nas próprias respostas.
                    // Limitação conhecida: as regras não conseguem validar item a
                    // item dentro de um array, então um usuário logado mal-intencionado
                    // poderia alterar respostas de terceiros. Corrigir exige mover as
                    // respostas para uma subcoleção — fica para a migração.
                    || (isSignedIn() && changedKeys().hasOnly(['replies']))
                    // o autor edita o texto do próprio comentário ou atualiza nome/foto nele
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && changedKeys().hasOnly(['content', 'replies', 'userName', 'userAvatar', 'userTitle', 'updatedAt']));

      // O próprio autor pode apagar o comentário (a interface oferece essa opção).
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // ============================================================
    // DADOS PESSOAIS — entram, mas não saem
    // Qualquer visitante cria o próprio registro (é assim que o
    // cadastro funciona), mas só o admin consegue ler a base.
    // ============================================================

    // ESTA COLEÇÃO NÃO TINHA REGRA NENHUMA: todo lead capturado
    // desde o lançamento foi recusado pelo banco e perdido.
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /newsletter/{subId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contacts/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ============================================================
    // USUÁRIOS
    // ============================================================

    match /users/{userId} {
      // Leitura exige login. Fecha a listagem anônima de e-mails dos leitores.
      allow read: if isSignedIn();

      // No cadastro, ninguém nasce admin (exceto o e-mail mestre).
      allow create: if isOwner(userId) && (
                      request.resource.data.role == 'reader' || isMasterAdmin()
                    );

      // O usuário edita o próprio perfil, mas nunca se promove.
      // Definir o próprio role como 'reader' é permitido: o login pelo Google
      // grava `role: existingUserData.role || 'reader'`, e em documentos antigos
      // sem o campo isso aparece como alteração de role. Rebaixar-se a leitor
      // não é escalada de privilégio.
      allow update: if isAdmin()
                    || (isOwner(userId) && (
                          !changedKeys().hasAny(['role'])
                          || request.resource.data.role == 'reader'
                       ));

      allow delete: if isAdmin();
    }

    // ============================================================
    // NOTIFICAÇÕES
    // Também estava sem regra nenhuma — nunca funcionou.
    // ============================================================

    match /notifications/{notifId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // ============================================================
    // ADMINISTRATIVO
    // ============================================================

    match /briefings/{briefingId} {
      allow read, write: if isAdmin();
    }

    // Guarda credenciais operacionais (ex: a URL do build hook do Netlify,
    // que dispara publicações). Precisa ficar fora do código do site: o painel
    // admin roda no navegador, então qualquer segredo escrito no fonte iria
    // junto no bundle JavaScript, à vista de qualquer visitante.
    // Aqui, só o admin autenticado consegue ler.
    match /admin_config/{configId} {
      allow read, write: if isAdmin();
    }

    // Qualquer coleção não listada acima fica negada por padrão.
  }
}
